                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" TextWrapping="Wrap" Text="后处理注入框架。从 reshade.me 下载支持完整插件功能的版本并缓存在本地。版权所有 © Crosire。" />
