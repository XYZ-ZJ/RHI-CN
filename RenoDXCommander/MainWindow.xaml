                                            <Run Text="界面设计" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}" />
                                            <Run Text=" 作者：Lazorr" Foreground="{StaticResource TextTertiaryBrush}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" TextWrapping="Wrap" Text="不知不觉，生活的许多方面都成了我设计界面的舞台。" />
