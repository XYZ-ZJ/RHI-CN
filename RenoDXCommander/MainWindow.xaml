                            </ComboBox>
                            <ComboBox x:Name="DxvkVariantCombo" x:FieldModifier="internal" SelectionChanged="DxvkVariantCombo_SelectionChanged">
                                <x:String>Development（每日构建版）</x:String>
                                <x:String>Stable（标记发布版）</x:String>
                                <x:String>Lilium HDR</x:String>
                            </ComboBox>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- end SettingsPanel -->

            <!--  ABOUT PANEL  -->
            <Grid x:Name="AboutPanel" x:FieldModifier="internal" Visibility="Collapsed" Background="{StaticResource SurfaceBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Back button bar -->
                <Border Grid.Row="0" Padding="24,12,24,10" Background="Transparent" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
