                                            <TextBlock Text="管理员模式" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <ComboBox x:Name="AdminModeCombo" x:FieldModifier="internal" SelectionChanged="AdminModeCombo_SelectionChanged" FontSize="12" Padding="8,4" CornerRadius="8" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="关" />
                                                <ComboBoxItem Content="开" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="拖放助手" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <ComboBox x:Name="DropHelperCombo" x:FieldModifier="internal" SelectionChanged="DropHelperCombo_SelectionChanged" FontSize="12" Padding="8,4" CornerRadius="8" HorizontalAlignment="Stretch" ToolTipService.ToolTip="拖放助手窗口支持在管理员模式下从 Discord 拖放文件。无需此功能时可关闭，修改后需重启。">
                                                <ComboBoxItem Content="关" />
                                                <ComboBoxItem Content="开" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <!-- System Tray description + combos -->
                                    <StackPanel Grid.Row="2" Spacing="4" Margin="0,12,0,0">
                                        <TextBlock Text="系统托盘" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="关闭时最小化到系统托盘。右键点击托盘图标或固定的任务栏图标，可快速启动最近的游戏。" />
                                    </StackPanel>
                                    <Grid Grid.Row="3" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="关闭时最小化到托盘" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <ComboBox x:Name="CloseToTrayCombo" x:FieldModifier="internal" SelectionChanged="CloseToTrayCombo_SelectionChanged" FontSize="12" Padding="8,4" CornerRadius="8" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="关" />
                                                <ComboBoxItem Content="开" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="最近游戏" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <ComboBox x:Name="RecentGamesCombo" x:FieldModifier="internal" SelectionChanged="RecentGamesCombo_SelectionChanged" FontSize="12" Padding="8,4" CornerRadius="8" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="关" />
                                                <ComboBoxItem Content="开" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Text="开机启动" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <ComboBox x:Name="StartWithWindowsCombo" x:FieldModifier="internal" SelectionChanged="StartWithWindowsCombo_SelectionChanged" FontSize="12" Padding="8,4" CornerRadius="8" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="关" />
                                                <ComboBoxItem Content="开" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 9: DATA & FOLDERS
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="数据与自定义文件" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="20">
                                    所有 RHI 数据均存储在 AppData 中。将自定义 ReShade、DLSS 或 Streamline DLL 拖入 Custom 文件夹，即可将其用作按游戏的覆盖文件。Logs 文件夹包含用于排查故障的会话日志。
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="OpenAppDataBtn" Content="应用数据目录" Click="OpenAppDataFolder_Click" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" FontSize="12" />
                                    <Button x:Name="OpenDownloadsBtn" Content="下载目录" Click="OpenDownloadsFolder_Click" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" FontSize="12" />
                                    <Button x:Name="OpenCustomBtn" Content="自定义目录" Click="OpenCustomFolder_Click" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" FontSize="12" />
                                    <Button x:Name="OpenLogsBtn" Content="日志目录" Click="OpenLogsFolder_Click" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" FontSize="12" />
                                    <Button x:Name="CopyLogsArchiveBtn" Content="复制日志" Click="CopyLogsArchive_Click" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" FontSize="12" ToolTipService.ToolTip="将全部日志打包为 ZIP 并复制到剪贴板，可直接粘贴到 Discord" />
                                    <Button x:Name="ExportGameDataBtn" x:FieldModifier="internal" Content="导出游戏数据" Click="ExportGameData_Click" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" FontSize="12" ToolTipService.ToolTip="收集游戏库数据（API、程序路径、引擎信息）并将 JSON 文件复制到剪贴板，可粘贴到 Discord 与 RHI 社区数据库分享" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

