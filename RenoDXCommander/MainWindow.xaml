                                </HyperlinkButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- end AboutPanel -->

            <!--  FAQ PANEL  -->
            <Grid x:Name="FaqPanel" x:FieldModifier="internal" Visibility="Collapsed" Background="{StaticResource SurfaceBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Back button bar -->
                <Border Grid.Row="0" Padding="24,12,24,10" Background="Transparent" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Content="← 返回游戏库" Click="FaqBack_Click" Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" FontSize="12" />
                        <TextBlock Text="快速入门指南" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Scrollable FAQ content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FaqContentPanel" x:FieldModifier="internal" Padding="32,24,32,40" Spacing="14" MaxWidth="900" HorizontalAlignment="Center" />
                </ScrollViewer>
            </Grid>

            <!-- end FaqPanel -->
        </Grid>

        <!-- end Row 1 content area -->

        <!--  ROW 2: STATUS BAR  -->
        <Border Grid.Row="2" Padding="20,6" Background="{StaticResource SurfaceStatusBarBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusBarText" Text="" FontSize="11" Foreground="{StaticResource TextDisabledBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource AccentAmberDimBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" Text="⚠ 在在线或多人游戏中，ReShade、OptiScaler 及 DLSS/Streamline 修改可能触发反作弊系统" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                    <Button x:Name="StatusBarVersionText" x:FieldModifier="internal" FontSize="11" Foreground="{StaticResource TextDisabledBrush}" Background="Transparent" BorderThickness="0" Padding="0,2" VerticalAlignment="Center" Click="StatusBarVersion_Click" ToolTipService.ToolTip="检查应用更新" />
                    <Button Content="更新说明" Click="PatchNotesLink_Click" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextDisabledBrush}" FontSize="11" Padding="8,2" VerticalAlignment="Center" ToolTipService.ToolTip="查看最近更新说明" />
                    <Button Content="今日消息" Click="MotdButton_Click" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextDisabledBrush}" FontSize="11" Padding="8,2" VerticalAlignment="Center" ToolTipService.ToolTip="显示今日消息" />
                    <Button x:Name="UpdateLogBtn" x:FieldModifier="internal" Content="更新记录" Click="UpdateLogButton_Click" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextDisabledBrush}" FontSize="11" Padding="8,2" VerticalAlignment="Center" ToolTipService.ToolTip="查看组件更新历史" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- (Old card DataTemplate removed — detail panel is now built in code-behind) -->
    </Grid>
</Window>
