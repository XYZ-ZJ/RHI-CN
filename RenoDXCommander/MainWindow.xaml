                                    <ProgressBar x:Name="DetailDcProgress" x:FieldModifier="internal" Visibility="Collapsed" Maximum="100" Height="3" CornerRadius="2" Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}" />
                                    <TextBlock x:Name="DetailDcMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}" Visibility="Collapsed" TextWrapping="Wrap" />
                                    <ProgressBar x:Name="DetailDofFixProgress" x:FieldModifier="internal" Visibility="Collapsed" Maximum="100" Height="3" CornerRadius="2" Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}" />
                                    <TextBlock x:Name="DetailDofFixMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}" Visibility="Collapsed" TextWrapping="Wrap" />
                                    <ProgressBar x:Name="DetailDxvkProgress" x:FieldModifier="internal" Visibility="Collapsed" Maximum="100" Height="3" CornerRadius="2" Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}" />
                                    <TextBlock x:Name="DetailDxvkMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}" Visibility="Collapsed" TextWrapping="Wrap" />
                                    <ProgressBar x:Name="DetailRdxProgress" x:FieldModifier="internal" Visibility="Collapsed" Maximum="100" Height="3" CornerRadius="2" Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}" />
                                    <TextBlock x:Name="DetailRdxMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}" Visibility="Collapsed" TextWrapping="Wrap" />
                                    <ProgressBar x:Name="DetailLumaProgress" x:FieldModifier="internal" Visibility="Collapsed" Maximum="100" Height="3" CornerRadius="2" Foreground="{StaticResource AccentGreenBrush}" Background="{StaticResource SurfaceToolbarBrush}" />
                                    <TextBlock x:Name="DetailLumaMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentGreenBrush}" Visibility="Collapsed" TextWrapping="Wrap" />
                                </StackPanel>
                                </StackPanel><!-- /DetailComponentsBody -->
                            </StackPanel>
                        </Border>

                        <!-- ── Game Overrides section ── -->
                        <Border x:Name="OverridesContainer" x:FieldModifier="internal" Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" Padding="14,12" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <!-- Collapse header — wired in BuildOverridesPanel -->
                                <StackPanel x:Name="OverridesHeaderRow" x:FieldModifier="internal" Orientation="Horizontal" Spacing="0" />
                                <!-- Body — all overrides content added here by builder -->
                                <StackPanel x:Name="OverridesPanel" x:FieldModifier="internal" Spacing="6" />
                            </StackPanel>
                        </Border>

                        <!-- ── Neural Rendering section ── -->
                        <Border x:Name="NeuralRenderingContainer" x:FieldModifier="internal" Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="NeuralRenderingPanel" x:FieldModifier="internal" Spacing="6" />
                        </Border>

                        <!-- ── DLSS / Streamline section ── -->
                        <Border x:Name="NvidiaProfileDlssContainer" x:FieldModifier="internal" Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="NvidiaProfileDlssPanel" x:FieldModifier="internal" Spacing="6" />
                        </Border>

                        <!-- ── Driver Settings section ── -->
                        <Border x:Name="NvidiaProfileDriverContainer" x:FieldModifier="internal" Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="NvidiaProfileDriverPanel" x:FieldModifier="internal" Spacing="6" />
                        </Border>

                        <!-- ── Legacy container — kept for migration, never shown ── -->
                        <Border x:Name="NvidiaProfileContainer" x:FieldModifier="internal" Visibility="Collapsed" />

                        <!-- ── Management section (folder, reset, report) ── -->
                        <Border x:Name="ManagementContainer" x:FieldModifier="internal" Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="ManagementPanel" x:FieldModifier="internal" Spacing="6" />
                        </Border>
                        <!-- ── Extras section ── -->
                        <Border x:Name="ExtrasContainer" x:FieldModifier="internal" Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" Padding="14,12" Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <StackPanel x:Name="ExtrasPanel" x:FieldModifier="internal" Spacing="6" />
                                <ProgressBar x:Name="DetailOsProgress" x:FieldModifier="internal" Visibility="Collapsed" Maximum="100" Height="3" CornerRadius="2" Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}" />
                                <TextBlock x:Name="DetailOsMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}" Visibility="Collapsed" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                    <!-- Skeleton detail panel overlay (removed programmatically after first load) -->
                    <ScrollViewer x:Name="SkeletonDetailScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Visible">
                        <StackPanel x:Name="SkeletonDetailPanel" Spacing="16" Padding="24,18,24,24" />
                    </ScrollViewer>

                </Grid>
            </Grid>

            <!--  SETTINGS PANEL  -->
            <Grid x:Name="SettingsPanel" x:FieldModifier="internal" Visibility="Collapsed" Background="{StaticResource SurfaceBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Back button bar -->
                <Border Grid.Row="0" Padding="24,12,24,10" Background="Transparent" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="SettingsBackBtn" Content="← 返回游戏库" Click="SettingsBack_Click" Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" FontSize="12" />
                        <TextBlock Text="设置" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Scrollable settings content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SettingsCardsPanel" x:FieldModifier="internal" Padding="32,24,32,40" Spacing="14" MaxWidth="800" HorizontalAlignment="Center">

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 1: GAME LIBRARY
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="组件更新" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Grid ColumnSpacing="0" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="25" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Check For Updates -->
                                <Grid Grid.Column="0" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Spacing="8">
                                        <TextBlock Text="检查更新" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="获取最新清单数据并检查所有组件更新，不受 4 小时间隔限制。" />
                                    </StackPanel>
                                    <Button Grid.Row="1" x:Name="CheckForUpdatesBtn" Content="检查更新" Click="CheckForUpdatesButton_Click" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="检查所有组件与应用程序更新" />
                                    <TextBlock Grid.Row="2" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Margin="0,8,0,0" Text="后台检查" />
                                    <ComboBox Grid.Row="3" x:Name="BackgroundUpdateChecksCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" SelectionChanged="BackgroundUpdateChecksCombo_SelectionChanged">
                                        <ToolTipService.ToolTip>
                                            <ToolTip>
                                                <TextBlock TextWrapping="Wrap" MaxWidth="280">
                                                    <Run Text="开启：启动时及每隔 4 小时自动检查所有更新，包括 ReShade、RenoDX、OptiScaler、Nexus Mods 等组件。" /><LineBreak />
                                                    <Run Text="最小：仅自动更新清单、PCGW 数据和 DLSS 版本。组件更新只在点击“刷新”或“全部更新”时检查。" />
                                                </TextBlock>
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                        <ComboBoxItem Content="开" />
                                        <ComboBoxItem Content="最小" />
                                    </ComboBox>
                                </Grid>

                                <!-- Divider -->
                                <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}" VerticalAlignment="Stretch" Margin="12,0,12,0" />

                                <!-- Right: Automatic Updates — uses same Grid structure as left so the combo aligns with Background Checks -->
                                <Grid Grid.Column="2" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Spacing="8">
                                        <TextBlock Text="自动更新" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="开启后，RHI 会在每次检查更新后静默安装组件更新。正在运行的游戏将在退出后自动重试。不适用于应用程序自身更新。" />
                                    </StackPanel>
                                    <!-- Rows 1–2 intentionally empty — spacers to match left column height -->
                                    <ComboBox Grid.Row="3" x:Name="AutoUpdateComponentsCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="在后台静默安装 ReShade、RenoDX、ReLimiter、DC、OptiScaler、RE Framework、Luma、DXVK 与景深修复更新" SelectionChanged="AutoUpdateComponentsCombo_SelectionChanged">
                                        <ComboBoxItem Content="否" />
                                        <ComboBoxItem Content="是" />
                                    </ComboBox>
                                </Grid>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 2: RESHADE & DISPLAY
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="ReShade 与显示" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Grid ColumnSpacing="0" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="25" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- ── Left: Screenshots & Hotkeys ── -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="截图与快捷键" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="截图保存路径与 ReShade 快捷键将应用到所有受管理的 reshade.ini 文件。" />
                                </StackPanel>

                                <!-- Divider -->
                                <Border Grid.Row="0" Grid.RowSpan="5" Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}" VerticalAlignment="Stretch" Margin="12,0,12,0" />

                                <!-- ── Right: HDR & Peak Brightness ── -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                    <TextBlock Text="HDR 与峰值亮度" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="将峰值亮度（尼特）写入 reshade.ini 预设。HDR 自动开关会在启动游戏时开启 Windows HDR，退出时关闭。" />
                                </StackPanel>

                                <!-- Row 1 Left: Screenshot path + Open -->
                                <Grid Grid.Row="1" Grid.Column="0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="ScreenshotPathBox" x:FieldModifier="internal" PlaceholderText="输入或选择截图目录" FontSize="12" Padding="12,8,36,8" Background="{StaticResource SurfaceInputBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" />
                                        <Button Click="BrowseScreenshotPath_Click" Background="Transparent" BorderThickness="0" Padding="8,6" MinWidth="0" MinHeight="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" ToolTipService.ToolTip="选择截图保存目录">
                                            <FontIcon Glyph="" FontSize="14" Foreground="{StaticResource TextTertiaryBrush}" />
                                        </Button>
                                    </Grid>
                                    <Button Grid.Column="1" Content="打开" Click="OpenScreenshotFolder_Click" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" FontSize="12" ToolTipService.ToolTip="在资源管理器中打开截图目录" />
                                </Grid>

                                <!-- Row 1 Right: Peak Nits -->
                                <Grid Grid.Row="1" Grid.Column="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="峰值亮度" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" x:Name="PeakNitsAutoBtn" Content="自动" Click="PeakNitsAuto_Click" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5" FontSize="12" ToolTipService.ToolTip="自动读取显示器峰值亮度。" />
                                    <TextBox Grid.Column="2" x:Name="PeakNitsBox" x:FieldModifier="internal" PlaceholderText="尼特" FontSize="12" VerticalContentAlignment="Center" Background="{StaticResource SurfaceInputBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" KeyDown="PeakNitsBox_KeyDown" />
                                    <Button Grid.Column="3" Content="⚙" Click="PeakNitsCog_Click" Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource ChipTextBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" MinWidth="0" MinHeight="0" FontSize="12" VerticalAlignment="Center" ToolTipService.ToolTip="设置哪些预设使用全局峰值亮度。" />
                                </Grid>

                                <!-- Row 2 Left: Overlay key | Screenshot key | Per-Game Folders combo -->
                                <Grid Grid.Row="2" Grid.Column="0" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" Text="浮层快捷键" Margin="0,0,0,3" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" Text="截图快捷键" Margin="0,0,0,3" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" Text="子目录" Margin="0,0,0,3" />
                                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="HotkeyBox" x:FieldModifier="internal" PlaceholderText="请按下按键..." IsReadOnly="True" FontSize="12" VerticalContentAlignment="Center" Background="{StaticResource SurfaceInputBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                    <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="ScreenshotHotkeyBox" x:FieldModifier="internal" PlaceholderText="请按下按键..." IsReadOnly="True" FontSize="12" VerticalContentAlignment="Center" Background="{StaticResource SurfaceInputBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" ToolTipService.ToolTip="按下按键以设置快捷键，按 Backspace 清除。" PreviewKeyDown="ScreenshotHotkeyBox_PreviewKeyDown" />
                                        <Button Grid.Column="1" Content="↺" Click="ResetScreenshotHotkey_Click" ToolTipService.ToolTip="重置为 Print Screen" Background="Transparent" BorderThickness="0" Padding="6,4" MinWidth="0" MinHeight="0" FontSize="14" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <ComboBox Grid.Row="1" Grid.Column="2" x:Name="PerGameScreenshotCombo" x:FieldModifier="internal" FontSize="12" MinWidth="60" ToolTipService.ToolTip="开启后，每个游戏使用独立的截图子目录。" SelectionChanged="PerGameScreenshotCombo_SelectionChanged">
                                        <ComboBoxItem Content="关" />
                                        <ComboBoxItem Content="开" />
                                    </ComboBox>
                                </Grid>

                                <!-- Row 2 Right: Apply to All Games (nits) -->
                                <Button Grid.Row="2" Grid.Column="2" x:Name="ApplyScreenshotPathBtn" Content="应用到全部游戏" Click="ApplyPeakNitsToAll_Click" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch" />
                                <!-- Row 4 Right: HDR Auto-Toggle + Select Monitors -->
                                <Grid Grid.Row="4" Grid.Column="2" ColumnSpacing="6" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="HDR 自动开关" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" x:Name="HdrAutoToggleCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" ToolTipService.ToolTip="开启后，通过 RHI 启动游戏时自动开启 Windows HDR，游戏退出时关闭。" SelectionChanged="HdrAutoToggleCombo_SelectionChanged">
                                        <ComboBoxItem Content="关" />
                                        <ComboBoxItem Content="开" />
                                    </ComboBox>
                                    <Button Grid.Column="2" Content="⚙" Click="HdrSelectMonitors_Click" Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource ChipTextBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" MinWidth="0" MinHeight="0" FontSize="12" VerticalAlignment="Center" ToolTipService.ToolTip="选择要开启 HDR 的显示器。留空表示仅主显示器。" />
                                </Grid>

                                <!-- Row 3 Left: Effect list style -->
                                <Grid Grid.Row="3" Grid.Column="0" ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="效果列表样式" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" x:Name="RsVariableListUseTabsCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="设置 ReShade 浮层中的着色器显示方式。选项卡按名称分组，树形显示可折叠的层级结构。" SelectionChanged="RsVariableListUseTabsCombo_SelectionChanged">
                                        <ComboBoxItem Content="选项卡" />
                                        <ComboBoxItem Content="树形" />
                                    </ComboBox>
                                </Grid>

                                <!-- Row 4: Apply buttons -->
                                <Button Grid.Row="4" Grid.Column="0" x:Name="ApplyHotkeyBtn" x:FieldModifier="internal" Content="应用到全部游戏" Click="ApplyScreenshotPath_Click" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch" />
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 2b: RESOLUTION CONTROL (dev-only — hidden by DevUnlockService)
                             ══════════════════════════════════════════════════════════ -->
                        <Border x:Name="ResolutionControlCard" x:FieldModifier="internal" Visibility="Collapsed" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="分辨率与色彩控制" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <Grid ColumnSpacing="0" RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Target Resolution + Auto-Toggle stacked -->
                                    <StackPanel Grid.Column="0" Spacing="12">
                                        <!-- Target Resolution -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="目标分辨率" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="启动游戏前切换到的桌面分辨率，退出后恢复。" />
                                            <ComboBox x:Name="ResolutionTargetCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="选择目标桌面分辨率。" SelectionChanged="ResolutionTargetCombo_SelectionChanged" />
                                        </StackPanel>

                                        <!-- Resolution Auto-Toggle -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="自动切换分辨率" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="开启后，启动游戏时切换到目标分辨率，退出时恢复。" />
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="自动切换分辨率" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1" x:Name="ResAutoToggleCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectionChanged="ResAutoToggleCombo_SelectionChanged">
                                                    <ComboBoxItem Content="关" />
                                                    <ComboBoxItem Content="开" />
                                                </ComboBox>
                                                <Button Grid.Column="2" Content="⚙" Click="ResSelectMonitors_Click" Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource ChipTextBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" MinWidth="0" MinHeight="0" FontSize="12" VerticalAlignment="Center" ToolTipService.ToolTip="选择需要切换分辨率的显示器。" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Divider -->
                                    <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}" VerticalAlignment="Stretch" Margin="12,0,12,0" />

                                    <!-- Right: Output Colour Settings -->
                                    <StackPanel Grid.Column="2" Spacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="输出色彩设置" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="直接设置显示器色深与动态范围。" />
                                        </StackPanel>

                                        <!-- Display selector -->
                                        <ComboBox x:Name="ColorDisplayCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="选择要配置的显示器。" SelectionChanged="ColorDisplayCombo_SelectionChanged" />

                                        <!-- Colour Depth + Dynamic Range + Apply -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="色深" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <ComboBox x:Name="ColorDepthCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="8 bpc" />
                                                    <ComboBoxItem Content="10 bpc" />
                                                    <ComboBoxItem Content="12 bpc" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="动态范围" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <ComboBox x:Name="ColorRangeCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="完整" />
                                                    <ComboBoxItem Content="有限" />
                                                </ComboBox>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="应用" x:Name="ColorApplyBtn" x:FieldModifier="internal" Click="ColorApplyBtn_Click" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" MinWidth="0" MinHeight="0" FontSize="12" VerticalAlignment="Bottom" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 2b2: DLDSR CONTROL (dev-only — gated by ResolutionControl feature flag)
                             ══════════════════════════════════════════════════════════ -->
                        <Border x:Name="DldsrControlCard" x:FieldModifier="internal" Visibility="Collapsed" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="DLDSR 控制" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Button x:Name="DldsrInfoBtn" x:FieldModifier="internal" Content="ⓘ" Click="DldsrInfoBtn_Click" Background="Transparent" Foreground="{StaticResource AccentTealBrush}" BorderThickness="0" Padding="4,0" MinWidth="0" MinHeight="0" FontSize="14" VerticalAlignment="Center" ToolTipService.ToolTip="DLDSR 控制使用方法" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="直接启用 DLDSR（深度学习动态超级分辨率）倍率。需先通过 NVIDIA 控制面板捕获状态。应用时显示器会黑屏约 15 秒。" />

                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Current State Display -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                                        <TextBlock Text="当前状态" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="DldsrCurrentStateText" x:FieldModifier="internal" Text="（尚未检查）" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>

                                    <!-- Row 1: DSR Smoothness Slider -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="DSR 平滑度" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="DldsrSmoothnessValueText" x:FieldModifier="internal" Text="33%" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Slider x:Name="DldsrSmoothnessSlider" x:FieldModifier="internal" Minimum="0" Maximum="100" StepFrequency="1" TickFrequency="10" HorizontalAlignment="Stretch" ToolTipService.ToolTip="调整 DSR 平滑度（0-100%）。数值越低越锐利，越高越平滑。应用时显示器会黑屏约 15 秒。" />
                                    </StackPanel>
                                    <Button Grid.Row="1" Grid.Column="1" x:Name="DldsrSmoothnessApplyBtn" x:FieldModifier="internal" Content="设置" Click="DldsrSmoothnessApplyBtn_Click" Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource ChipTextBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="16,6" MinWidth="0" MinHeight="0" FontSize="12" VerticalAlignment="Bottom" ToolTipService.ToolTip="应用所选平滑度，显示器会黑屏约 15 秒。" />

                                    <!-- Row 2: Saved States combo + Apply button -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="已保存状态" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <ComboBox x:Name="DldsrStateCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="选择先前捕获的 DLDSR 状态并应用。" />
                                    </StackPanel>
                                    <Button Grid.Row="2" Grid.Column="1" x:Name="DldsrApplyBtn" x:FieldModifier="internal" Content="应用" Click="DldsrApplyBtn_Click" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,6" MinWidth="0" MinHeight="0" FontSize="12" VerticalAlignment="Bottom" ToolTipService.ToolTip="应用所选 DLDSR 状态，显示器会黑屏约 15 秒。" />

                                    <!-- Row 3: Capture / Delete buttons -->
                                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="DldsrCaptureBtn" x:FieldModifier="internal" Content="捕获当前状态" Click="DldsrCaptureBtn_Click" Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource ChipTextBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" MinWidth="0" MinHeight="0" FontSize="11" ToolTipService.ToolTip="捕获 NVIDIA 控制面板中的当前 DLDSR 状态。请先在控制面板中配置 DLDSR，再进行捕获。" />
                                        <Button x:Name="DldsrDeleteBtn" x:FieldModifier="internal" Content="删除" Click="DldsrDeleteBtn_Click" Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource ChipTextBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" MinWidth="0" MinHeight="0" FontSize="11" ToolTipService.ToolTip="删除当前选中的已保存状态。" />
                                        <Button x:Name="DldsrRefreshBtn" x:FieldModifier="internal" Content="刷新" Click="DldsrRefreshBtn_Click" Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource ChipTextBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" MinWidth="0" MinHeight="0" FontSize="11" ToolTipService.ToolTip="从注册表刷新当前 DLDSR 状态。" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 2c: NEXUS MODS (dev-only — hidden by DevUnlockService)
                             ══════════════════════════════════════════════════════════ -->
                        <Border x:Name="NexusModsCard" x:FieldModifier="internal" Visibility="Collapsed" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Nexus Mods" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />

                                <Grid ColumnSpacing="0" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Left description -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="API 密钥" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="粘贴 Nexus Mods 个人 API 密钥。高级会员可一键下载并静默自动更新，免费用户可一键通过浏览器下载。" />
                                    </StackPanel>

                                    <!-- Divider -->
                                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}" VerticalAlignment="Stretch" Margin="12,0,12,0" />

                                    <!-- Right: connection status + NXM toggle -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                        <TextBlock Text="NXM 协议处理程序" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="将 RHI 注册为 nxm:// 协议处理程序，使 Nexus 的“使用模组管理器下载”按钮直接在 RHI 中打开。" />
                                    </StackPanel>

                                    <!-- Row 1 Left: API key input + Connect/Disconnect buttons -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="NexusConnectBtn" x:FieldModifier="internal" Grid.Column="0" Content="连接" Click="NexusConnectBtn_Click" Background="{StaticResource AccentGreenBrush}" Foreground="White" BorderThickness="0" CornerRadius="6" Padding="12,6" MinWidth="0" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                        </Grid>
                                        <TextBlock x:Name="NexusStatusText" x:FieldModifier="internal" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextTertiaryBrush}" Text="未连接" />
                                    </StackPanel>

                                    <!-- Row 1 Right: NXM handler register/unregister -->
                                    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="6">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="NxmStatusText" x:FieldModifier="internal" Grid.Column="0" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="未注册" />
                                            <Button x:Name="NxmRegisterBtn" x:FieldModifier="internal" Grid.Column="1" Content="注册" Click="NxmRegisterBtn_Click" Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource ChipTextBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" MinWidth="0" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Row 2: Disconnect row (shown only when connected) -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4" x:Name="NexusDisconnectRow" x:FieldModifier="internal" Visibility="Collapsed">
                                        <Button Content="断开连接" Click="NexusDisconnectBtn_Click" Background="Transparent" Foreground="{StaticResource AccentRedBrush}" BorderBrush="{StaticResource AccentRedBrush}" BorderThickness="1" CornerRadius="6" Padding="12,4" MinWidth="0" FontSize="11" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 2d: RENODX DATA SOURCE (dev-only — hidden by DevUnlockService)
                             ══════════════════════════════════════════════════════════ -->
                        <Border x:Name="RenoDxDbSourceCard" x:FieldModifier="internal" Visibility="Collapsed" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="0" RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Data Source combo -->
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <TextBlock Text="模组数据源" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="设置模组数据来源。推荐使用社区维护的 RHI 数据库；也可选择 RenoDX 百科抓取器。修改后将立即刷新。" />
                                        <Grid ColumnSpacing="8" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="来源" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <ComboBox x:Name="RenoDxDbSourceCombo" x:FieldModifier="internal" Grid.Column="1" FontSize="12" HorizontalAlignment="Left" MinWidth="160">
                                                <ComboBoxItem Content="RHI 数据库" Tag="DbOnly" />
                                                <ComboBoxItem Content="RenoDX 百科" Tag="WikiOnly" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Divider -->
                                    <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}" VerticalAlignment="Stretch" Margin="20,0,20,0" />

                                    <!-- Right: GitHub API Rate Limit -->
                                    <StackPanel Grid.Column="2" Spacing="8">
                                        <TextBlock Text="GitHub API" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="登录 GitHub 可将 API 限额从每小时 60 次提高到 5,000 次，改善更新检查、DLSS 版本查询与清单获取的可靠性。" />

                                        <!-- Connect button -->
                                        <Button x:Name="GitHubConnectBtn" x:FieldModifier="internal" Content="连接 GitHub" Click="GitHubConnectBtn_Click" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" MinWidth="0" FontSize="12" HorizontalAlignment="Left" />

                                        <!-- Status text (connected / code display / error) -->
                                        <TextBlock x:Name="GitHubStatusText" x:FieldModifier="internal" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextTertiaryBrush}" Text="未连接（每小时 60 次请求）" />

                                        <!-- Device code panel — shown during auth flow -->
                                        <StackPanel x:Name="GitHubDeviceCodePanel" x:FieldModifier="internal" Spacing="6" Visibility="Collapsed">
                                            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource InlineDescriptionBrush}" Text="打开下方链接并输入此代码：" />
                                            <TextBlock x:Name="GitHubUserCodeText" x:FieldModifier="internal" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="XXXX-XXXX" CharacterSpacing="200" />
                                            <HyperlinkButton x:Name="GitHubVerificationLink" x:FieldModifier="internal" Content="github.com/login/device" NavigateUri="https://github.com/login/device" FontSize="11" Padding="0" />
                                        </StackPanel>

                                        <!-- Disconnect row — shown only when connected -->
                                        <StackPanel x:Name="GitHubDisconnectRow" x:FieldModifier="internal" Spacing="4" Visibility="Collapsed">
                                            <Button Content="断开连接" Click="GitHubDisconnectBtn_Click" Background="Transparent" Foreground="{StaticResource AccentRedBrush}" BorderBrush="{StaticResource AccentRedBrush}" BorderThickness="1" CornerRadius="6" Padding="12,4" MinWidth="0" FontSize="11" HorizontalAlignment="Left" />
                                        </StackPanel>

                                        <!-- PAT (Personal Access Token) alternative -->
                                        <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource InlineDescriptionBrush}" Text="或粘贴 GitHub 个人访问令牌（PAT）。令牌在撤销前持续有效，无需选择权限范围，生成后粘贴即可。" />
                                        <HyperlinkButton NavigateUri="https://github.com/settings/tokens/new?description=RHI&amp;scopes=" FontSize="11" Padding="0" Margin="0,-4,0,0" Content="在 github.com/settings/tokens 创建令牌（无需勾选权限）" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBox x:Name="GitHubPatBox" x:FieldModifier="internal" PlaceholderText="ghp_..." FontSize="11" Width="220" CornerRadius="6" IsSpellCheckEnabled="False" InputScope="Url" />
                                            <Button x:Name="GitHubPatSaveBtn" x:FieldModifier="internal" Content="保存" Click="GitHubPatSaveBtn_Click" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" MinWidth="0" FontSize="11" />
                                            <Button x:Name="GitHubPatClearBtn" x:FieldModifier="internal" Content="清除" Click="GitHubPatClearBtn_Click" Background="Transparent" Foreground="{StaticResource AccentRedBrush}" BorderBrush="{StaticResource AccentRedBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" MinWidth="0" FontSize="11" />
                                        </StackPanel>
                                        <TextBlock x:Name="GitHubPatStatusText" x:FieldModifier="internal" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextTertiaryBrush}" Text="" Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 3: DLSS & STREAMLINE
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="DLSS / Streamline 设置" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Grid ColumnSpacing="0" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Defaults + DMFG Defaults + Batch Deploy -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Spacing="8">
                                        <TextBlock Text="默认设置" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="设置首选 DLSS/Streamline 版本、预设与渲染比例。可在游戏的 NVIDIA 配置中通过“快速应用”使用这些设置。" />
                                        <Button Content="配置默认设置" Click="DlssDefaults_Click" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch" />
                                        <StackPanel x:Name="DlssDefaultsSummaryPanel" x:FieldModifier="internal" Spacing="4" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <!-- DMFG Defaults (global base profile) -->
                                    <StackPanel Grid.Row="1" Spacing="8" Margin="0,16,0,0">
                                        <TextBlock Text="DMFG 默认设置" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="全局动态多帧生成默认设置。设置一次后，只需在游戏的 MFG 对话框中启用动态模式。" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="帧数" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" />
                                                <ComboBox x:Name="DmfgFrameCountCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="全局 DMFG 最大帧数。使用动态模式的游戏继承此设置，除非单独覆盖。" SelectionChanged="DmfgFrameCountCombo_SelectionChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="目标帧率" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" />
                                                <ComboBox x:Name="DmfgTargetFpsCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="全局 DMFG 目标帧率。“关”表示不设目标，“最高刷新率”表示匹配显示器，也可选择指定帧率。" SelectionChanged="DmfgTargetFpsCombo_SelectionChanged" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
                                        <TextBlock Text="批量部署" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="将指定 DLSS、Streamline DLL 版本及 DLSS 预设批量部署到多个游戏。自动备份原始文件，并预填已配置的默认值。" />
                                        <Button Content="批量部署" Click="MassDlssDeploy_Click" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>

                                <!-- Divider -->
                                <Border Grid.Column="1" Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="16,0" />

                                <!-- Right: DLSS & G-Sync Indicators + Auto-Update -->
                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Text="DLSS 屏幕指示器" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="控制游戏角落的 NVIDIA DLSS 文字浮层。此为影响全部游戏的系统全局设置，需要管理员权限。" />
                                    <ComboBox x:Name="DlssIndicatorCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" SelectionChanged="DlssIndicatorCombo_SelectionChanged">
                                        <ComboBoxItem Content="已启用" />
                                        <ComboBoxItem Content="已禁用" />
                                    </ComboBox>

                                    <TextBlock Text="G-Sync 屏幕指示器" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" />
                                    <ComboBox x:Name="GSyncIndicatorCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" SelectionChanged="GSyncIndicatorCombo_SelectionChanged">
                                        <ComboBoxItem Content="已启用" />
                                        <ComboBoxItem Content="已禁用" />
                                    </ComboBox>

                                    <TextBlock Text="自动更新" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="发布新版本后自动替换。仅影响当前使用上一最新版本的游戏，手动选择旧版本的游戏保持原样。" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="DLSS" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" />
                                            <ComboBox x:Name="AutoUpdateDlssCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" SelectionChanged="AutoUpdateDlssCombo_SelectionChanged">
                                                <ComboBoxItem Content="关" />
                                                <ComboBoxItem Content="开" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Streamline" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" />
                                            <ComboBox x:Name="AutoUpdateStreamlineCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" SelectionChanged="AutoUpdateStreamlineCombo_SelectionChanged">
                                                <ComboBoxItem Content="关" />
                                                <ComboBoxItem Content="开" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 4: GLOBAL NVIDIA DRIVER SETTINGS
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="全局 NVIDIA 驱动设置" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Grid ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="25" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left column -->
                                <StackPanel Grid.Column="0" Spacing="12" VerticalAlignment="Top">
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="通过 NVIDIA 基础配置全局应用驱动设置。各游戏的独立设置位于其覆盖面板中的 NVIDIA 配置区域。" />

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="着色器缓存大小" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" />
                                            <ComboBox x:Name="ShaderCacheSizeCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="已编译着色器缓存的最大磁盘占用。缓存越大，再次进入场景时卡顿越少。驱动默认值为 16GB。" SelectionChanged="ShaderCacheSizeCombo_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="着色器预编译" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" />
                                            <ComboBox x:Name="ShaderPrecompileCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="空闲时在后台自动编译着色器。数值越高，空闲 CPU 占用越大，首次游戏加载越快。" SelectionChanged="ShaderPrecompileCombo_SelectionChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="G-Sync" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" />
                                            <ComboBox x:Name="GSyncEnableCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="全局启用或禁用 G-Sync/FreeSync 可变刷新率。" SelectionChanged="GSyncEnableCombo_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="G-Sync 模式" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" />
                                            <ComboBox x:Name="GSyncModeCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="控制 G-Sync/FreeSync 可变刷新率，建议使用“全屏和窗口化”以获得连贯体验。" SelectionChanged="GSyncModeCombo_SelectionChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="帧率限制" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" />
                                            <ComboBox x:Name="FpsLimitCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="通过 NVIDIA 驱动设置全局帧率上限。VRR 优化预设将帧率限制在略低于刷新率的位置，以保持在 VRR 范围内。" SelectionChanged="FpsLimitCombo_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="首选刷新率" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" />
                                            <ComboBox x:Name="PreferredRefreshRateCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="“最高可用”强制使用最高刷新率，“应用程序设置”由游戏自行选择。" SelectionChanged="PreferredRefreshRateCombo_SelectionChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="垂直同步" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" />
                                            <ComboBox x:Name="GlobalVSyncCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="全局垂直同步模式，应用于未单独覆盖的游戏。" SelectionChanged="GlobalVSyncCombo_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="电源模式" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" />
                                            <ComboBox x:Name="GlobalPowerModeCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="全局电源管理模式，应用于未单独覆盖的游戏。" SelectionChanged="GlobalPowerModeCombo_SelectionChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- ReBAR row -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="ReBAR" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" />
                                                <TextBlock x:Name="ReBarAdminWarning" x:FieldModifier="internal" Text="需要管理员权限" FontSize="11" Foreground="{StaticResource AccentAmberBrush}" Visibility="Collapsed" />
                                            </StackPanel>
                                            <ComboBox x:Name="GlobalReBarEnableCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="全局 Resizable BAR，为全部游戏启用大块显存传输。需要管理员权限及兼容硬件（RTX 30 系列及更新型号）。" SelectionChanged="GlobalReBarEnableCombo_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="ReBAR 大小限制" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" />
                                            <ComboBox x:Name="GlobalReBarSizeCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="BAR 最大传输大小。多数游戏建议使用 1GB；如出现相关卡顿，可降低到 512MB。" SelectionChanged="GlobalReBarSizeCombo_SelectionChanged" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}" VerticalAlignment="Stretch" Margin="12,0,12,0" />

                                <!-- Right column -->
                                <StackPanel Grid.Column="2" Spacing="12" VerticalAlignment="Top">
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="分别调整各显示器的 NVIDIA 数字振动（色彩饱和度）。应用程序启动时自动恢复已保存的值。" />
                                    <Button Content="数字振动" Click="DigitalVibrance_Click" ToolTipService.ToolTip="分别调整各显示器的数字振动（色彩饱和度），启动时恢复已保存的值。" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch" />

                                    <!-- Create Missing Profiles -->
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="没有 NVIDIA 配置的游戏无法受益于全局驱动设置。为游戏库中的全部游戏创建配置，确保全局设置生效。" />
                                    <Button Content="创建缺失配置" Click="CreateMissingNvidiaProfiles_Click" ToolTipService.ToolTip="为尚无 NVIDIA 驱动配置的游戏创建配置，确保电源模式、垂直同步等全局设置生效。" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch" />

                                    <TextBlock Text="备份可将各游戏的 NVIDIA 驱动设置保存到文件，恢复可重新导入。建议在更新驱动前备份。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                                    <Grid ColumnSpacing="12" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="备份配置" Click="ExportNvidiaProfiles_Click" ToolTipService.ToolTip="将全部游戏的 NVIDIA 配置保存到备份文件。" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1" Content="恢复配置" Click="ImportNvidiaProfiles_Click" ToolTipService.ToolTip="从先前导出的文件恢复各游戏的 NVIDIA 配置。" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch" />
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="重置 NVIDIA 配置" Click="ResetAllNvidiaProfiles_Click" ToolTipService.ToolTip="移除所有游戏的 NVIDIA 配置覆盖，并将全局配置恢复为初始状态。" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="#CC4444" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1" Content="清理着色器缓存" Click="ClearNvidiaShaderCache_Click" ToolTipService.ToolTip="删除 NVIDIA DXCache 和 GLCache 目录，下次启动游戏时将重新编译着色器。" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="#CC4444" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 5: COMPONENT SETTINGS (ReLimiter + OptiScaler)
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="组件设置" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Grid ColumnSpacing="0" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="25" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Left: ReLimiter -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="ReLimiter" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="应用到全部游戏的 ReLimiter 屏显快捷键与全局功能设置。" />
                                </StackPanel>

                                <!-- Divider -->
                                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}" VerticalAlignment="Stretch" Margin="12,0,12,0" />

                                <!-- Right: OptiScaler -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                    <TextBlock Text="OptiScaler" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="OptiScaler 的 GPU 类型、DLSS 输入与浮层快捷键设置。" />
                                </StackPanel>

                                <!-- Row 1 Left: ReLimiter controls -->
                                <Grid Grid.Row="1" Grid.Column="0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" Text="屏显快捷键" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" Text="共享预设" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" Text="DLSS 挂钩" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" Text="目标帧率" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="UlHotkeyBox" x:FieldModifier="internal" PlaceholderText="请按下按键..." IsReadOnly="True" FontSize="12" MinWidth="80" Background="{StaticResource SurfaceInputBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" ToolTipService.ToolTip="在游戏中切换 ReLimiter 屏显浮层的按键。" PreviewKeyDown="UlHotkeyBox_PreviewKeyDown" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="UlSharedPresetsCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="开启后，全部游戏共享屏显预设文件；关闭后，每个游戏使用独立预设。" SelectionChanged="UlSharedPresetsCombo_SelectionChanged">
                                        <ComboBoxItem Content="关" />
                                        <ComboBoxItem Content="开" />
                                    </ComboBox>
                                    <ComboBox Grid.Row="1" Grid.Column="2" x:Name="UlDlssHooksCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="在 ReLimiter 屏显中显示 DLSS 质量模式、渲染分辨率与启用的功能。如遇崩溃请关闭。" SelectionChanged="UlDlssHooksCombo_SelectionChanged">
                                        <ComboBoxItem Content="关" />
                                        <ComboBoxItem Content="开" />
                                    </ComboBox>
                                    <ComboBox Grid.Row="1" Grid.Column="3" x:Name="UlTargetFpsCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="写入所有 relimiter.ini 文件的全局帧率上限。可选择 VRR 预设，或通过“自定义”手动设置。" SelectionChanged="UlTargetFpsCombo_SelectionChanged">
                                        <!-- Items populated in code-behind -->
                                    </ComboBox>
                                </Grid>

                                <!-- Row 1 Right: OptiScaler controls -->
                                <Grid Grid.Row="1" Grid.Column="2" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Spacing="4">
                                        <TextBlock Text="GPU 类型" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" />
                                        <ComboBox x:Name="OsGpuCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" Background="{StaticResource SurfaceInputBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" SelectionChanged="OsGpuCombo_SelectionChanged">
                                            <x:String>NVIDIA</x:String>
                                            <x:String>AMD</x:String>
                                            <x:String>Intel</x:String>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Spacing="4" x:Name="OsDlssInputsPanel" x:FieldModifier="internal" Visibility="Collapsed">
                                        <TextBlock Text="DLSS 输入" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" />
                                        <ComboBox x:Name="OsDlssInputsCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" Background="{StaticResource SurfaceInputBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" SelectionChanged="OsDlssInputsCombo_SelectionChanged">
                                            <x:String>Yes</x:String>
                                            <x:String>No</x:String>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2 Left: ReLimiter Apply -->
                                <Button Grid.Row="2" Grid.Column="0" x:Name="ApplyUlHotkeyBtn" x:FieldModifier="internal" Content="应用到全部游戏" Click="ApplyUlOsdHotkey_Click" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch" />

                                <!-- Row 2 Right: OptiScaler Hotkey + Apply -->
                                <Grid Grid.Row="2" Grid.Column="2" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="OsHotkeyCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" Background="{StaticResource SurfaceInputBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" SelectionChanged="OsHotkeyCombo_SelectionChanged">
                                        <x:String>Insert</x:String>
                                        <x:String>Home</x:String>
                                        <x:String>End</x:String>
                                        <x:String>Delete</x:String>
                                        <x:String>Page Up</x:String>
                                        <x:String>Page Down</x:String>
                                        <x:String>F1</x:String>
                                        <x:String>F2</x:String>
                                        <x:String>F3</x:String>
                                        <x:String>F4</x:String>
                                        <x:String>F5</x:String>
                                        <x:String>F6</x:String>
                                        <x:String>F7</x:String>
                                        <x:String>F8</x:String>
                                        <x:String>F9</x:String>
                                        <x:String>F10</x:String>
                                        <x:String>F11</x:String>
                                        <x:String>F12</x:String>
                                    </ComboBox>
                                    <Button Grid.Column="1" x:Name="ApplyOsHotkeyBtn" x:FieldModifier="internal" Content="应用到全部游戏" Click="ApplyOsHotkey_Click" Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch" />
                                </Grid>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 6: SHADERS & ADDONS
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="着色器与插件" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Grid ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="25" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Shader Management + Cache -->
                                <StackPanel Grid.Column="0" Spacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="着色器管理" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="设置 RHI 管理各游戏着色器文件的方式。" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="着色器管理" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" Margin="0,0,0,3" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="缓存全部着色器" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" Margin="0,0,0,3" />
                                        <ComboBox Grid.Row="1" Grid.Column="0" x:Name="CustomShadersCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="由 RHI 管理：将内置着色器包部署到全部游戏。&#xA;自定义：使用你自己的着色器目录。&#xA;关：RHI 不修改任何游戏的着色器。" SelectionChanged="CustomShadersCombo_SelectionChanged">
                                            <ComboBoxItem Content="关" />
                                            <ComboBoxItem Content="由 RHI 管理" />
                                            <ComboBoxItem Content="自定义" />
                                        </ComboBox>
                                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CacheAllShadersCombo" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Stretch" ToolTipService.ToolTip="开启后，启动时下载并缓存全部着色器包；关闭后，按需下载。" SelectionChanged="CacheAllShadersCombo_SelectionChanged">
                                            <ComboBoxItem Content="关" />
                                            <ComboBoxItem Content="开" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}" VerticalAlignment="Stretch" Margin="12,0,12,0" />

                                <!-- Right: Addon Watch Folder -->
                                <StackPanel Grid.Column="2" Spacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="插件监视目录" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Text="RHI 会监视此目录中的 RenoDX 插件文件（.addon64/.addon32）与压缩包，默认为下载目录。" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
