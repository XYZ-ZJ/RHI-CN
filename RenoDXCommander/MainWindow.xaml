                                    <Image Source="icon.ico" Width="48" Height="48" />
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock FontSize="20" FontWeight="Bold">
                                            <Run Text="RHI" Foreground="{StaticResource AccentTealBrush}" />
                                        </TextBlock>
                                        <TextBlock x:Name="AboutVersionText" x:FieldModifier="internal" FontSize="12" Foreground="{StaticResource InlineDescriptionBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" LineHeight="20" Text="一体化 PC 游戏增强工具。自动检测 8 个游戏平台的游戏，一站式管理 ReShade、HDR 模组、着色器、DLSS/Streamline、帧率限制器与 NVIDIA 驱动配置等功能。" />

                                <!-- What it does -->
                                <Border Background="{StaticResource SurfaceToolbarBrush}" CornerRadius="8" Padding="14,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="RHI 管理的内容" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
